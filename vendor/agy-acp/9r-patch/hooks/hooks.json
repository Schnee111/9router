{
  "bridge-no-builtin-tools": {
    "PreToolUse": [
      {
        "matcher": "run_command|read_file|write_file|edit_file|view_file|grep_search|list_dir|find_by_name|search_web|manage_task|browser_.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 deny_builtin.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
